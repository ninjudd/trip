+install_release() {
+  local url="${TRIP_ARCHIVE:-https://github.com/$TRIP_REPO/archive/$TRIP_REF.tar.gz}" label version
+  case "$TRIP_REPO" in
+    */*/* | *[!A-Za-z0-9._/-]* | /* | */) die "TRIP_REPO must be owner/name, not $TRIP_REPO" ;;
