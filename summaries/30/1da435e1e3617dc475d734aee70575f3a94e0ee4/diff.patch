diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..d31d38a
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,97 @@
+name: Release
+# Start a release by hand: choose patch, minor, or major, and the propose job
+# opens a pull request that raises the version. Merging it is the decision to
+# ship; the publish job then tags the merged version, creates the GitHub
+# release, and moves the major tag last.
+on:
+  workflow_dispatch:
+    inputs:
+      bump:
+        description: Which part of the version to raise
+        type: choice
+        options: [patch, minor, major]
+        default: patch
+  push:
+    branches: [main]
+    paths: [Cargo.toml]
+permissions:
+  contents: read
+concurrency:
+  group: release
+  cancel-in-progress: false
+jobs:
+  propose:
+    if: github.event_name == 'workflow_dispatch'
+    runs-on: ubuntu-latest
+    permissions:
+      actions: write
+      contents: write
+      pull-requests: write
+    steps:
+      - uses: actions/checkout@v5
+      - name: Open the release pull request
+        env:
+          BUMP: ${{ inputs.bump }}
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          # The checkout is the ref the run was dispatched from, and the release
+          # branch carries every commit it has. check-commit reads only the
+          # release commit, so a run from another ref would carry that ref's
+          # unreviewed commits into the release.
+          if [ "$GITHUB_REF" != refs/heads/main ]; then
+            echo "run the release from main, not $GITHUB_REF" >&2
+            exit 1
+          fi
+          version=$(python3 .github/scripts/release.py bump "$BUMP")
+          branch="release/v$version"
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git switch -c "$branch"
+          git commit --quiet -am "Release $version"
+          python3 .github/scripts/release.py check-commit HEAD
+          # The branch belongs to this workflow; a rerun after a run that pushed it
+          # but could not open the pull request replaces it.
+          git push --quiet --force origin "$branch"
+          cat > "$RUNNER_TEMP/body.md" <<EOF
+          Raises trip's version to $version in \`Cargo.toml\` and \`Cargo.lock\`. Merging this pull request publishes the release: the Release workflow then tags \`v$version\` on the merge commit, creates the GitHub release with generated notes, and moves \`v0\` to it, which is where the installer and \`trip upgrade\` find the newest release.
+
+          ## Testing
+
+          The Release workflow ran \`python3 .github/scripts/release.py bump $BUMP\` from the repository root, which printed \`$version\` and wrote it to both version files, and \`python3 .github/scripts/release.py check-commit HEAD\`, which refuses a commit that changes anything but the version. It then dispatched the Check workflow on this branch, and its checks appear on this pull request; \`cargo build --locked\` there fails if the two files disagree. After the merge, the publish job runs \`python3 .github/scripts/release.py tag\`. A failure there names the step that failed, and re-running the failed job finishes the release.
+          EOF
+          # A pull request someone opened by hand from the branch after a failed run
+          # already carries the force-pushed commit.
+          if [ -n "$(gh pr list --head "$branch" --state open --json number --jq '.[].number')" ]; then
+            echo "a pull request from $branch is already open"
+          else
+            gh pr create --base main --head "$branch" --title "Release $version" --body-file "$RUNNER_TEMP/body.md"
+          fi
+          # GitHub starts no workflow for a pull request this job's token opened,
+          # or for the push before it, so Check would never run on the release.
+          # workflow_dispatch is the exception, and its checks land on the
+          # branch's commit, which is the pull request's head.
+          gh workflow run check.yml --ref "$branch"
+  publish:
+    if: github.event_name == 'push'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          fetch-depth: 0
+      # A Cargo.toml change that leaves the version alone or lowers it releases
+      # nothing, so an unreleased version such as 0.1.0 is never published by a
+      # dependency bump or a revert. `tag` releases the commit this push made,
+      # and does only the steps still missing, so re-running a failed job
+      # finishes the release.
+      - name: Tag and publish the merged version
+        env:
+          BEFORE: ${{ github.event.before }}
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          python3 .github/scripts/release.py tag --commit "$GITHUB_SHA" --since "$BEFORE"
diff --git a/README.md b/README.md
index 8adb2f4..ce100ec 100644
--- a/README.md
+++ b/README.md
@@ -364,6 +364,18 @@ Trip is infrastructure. It should feel tiny, durable, and boring in a good way.
 
 The core primitive is a **persistent PTY-backed session**. Everything else is optional.
 
+## Releasing
+
+A release is a version-only pull request that a workflow opens for you. Start it from `main`, choosing `patch`, `minor`, or `major`:
+
+```
+gh workflow run release.yml -f bump=minor
+```
+
+The Release workflow raises the version in `Cargo.toml` and `Cargo.lock` on a `release/vX.Y.Z` branch, refuses the commit if it changes anything else, opens the pull request, and runs the Check workflow on it. Merging that pull request is the decision to ship: the workflow then tags `vX.Y.Z` on the merge commit, creates the GitHub release with generated notes, and moves `v0`, the tag the installer serves, to it last. If that publish job fails partway, re-run it, and it does only the steps still missing. A merge that changes `Cargo.toml` without raising the version releases nothing, so reverting a release pull request leaves `v0` where it was. The workflow refuses a new version below the newest release and never moves `v0` back to an older one.
+
+The workflow opens the pull request with its own token, which needs **Allow GitHub Actions to create and approve pull requests** turned on under the repository's **Settings > Actions > General**. `.github/scripts/release.py` does the work, and `python3 tests/release_test.py` tests it.
+
 ## Requirements
 
 - macOS or Linux
diff --git a/docs/projects/releases/readme.md b/docs/projects/releases/readme.md
index dd58bc4..9d0880f 100644
--- a/docs/projects/releases/readme.md
+++ b/docs/projects/releases/readme.md
@@ -26,14 +26,14 @@ The repository has no CI either. Its only workflow publishes the project site, s
 1. You start the release with `gh workflow run release.yml -f bump=patch`, `minor`, or `major`.
 2. The workflow's propose job refuses any ref other than `main`. It bumps the version in every file that holds it (§ 2.5), commits `Release X.Y.Z` on a `release/vX.Y.Z` branch, and refuses the commit if it touches any file but those. It pushes the branch and opens the release pull request, or reuses one that is already open.
 3. A pull request that the workflow's own token opens starts no workflow by itself, so the propose job dispatches `check.yml` onto the release branch. The pull request then shows its checks.
-4. You approve and merge the release pull request. Merging it is the decision to ship.
-5. The push to `main` that changes the version starts the publish job. It checks whether the release is already complete and does only the steps still missing, in this order:
+4. You merge the release pull request once its checks pass. Merging it is the decision to ship.
